digraph ERD {
  graph [bgcolor="white", fontname="Arial", labelloc="t", labeljust="l", margin="0.00", nodesep="0.14", ranksep="0.30", pad="0.02", splines="polyline", outputorder="edgesfirst", overlap="false", rankdir="TB", label="Фрагмент 2.5в — учебные планы, пользователи и служебные таблицы"];
  node [shape="plain", fontname="Arial"];
  edge [fontname="Arial", fontsize="7", color="#000000", fontcolor="#000000", arrowsize="0.45"];

